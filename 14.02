<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>За Деница ❤️</title>

<style>
body{
margin:0;
overflow:hidden;
background:linear-gradient(to bottom,#1a001f,#000);
font-family:Arial, sans-serif;
text-align:center;
color:white;
}

/* Бутон */
#heartBtn{
margin-top:100px;
font-size:80px;
background:none;
border:none;
cursor:pointer;
animation:pulse 1.2s infinite;
}

@keyframes pulse{
0%{transform:scale(1)}
50%{transform:scale(1.2)}
100%{transform:scale(1)}
}

.teddy{
position:absolute;
top:50%;
font-size:70px;
}

.heart{
position:absolute;
font-size:24px;
animation:fall 3s linear forwards;
}

@keyframes fall{
to{transform:translateY(100vh);opacity:0}
}

#message{
position:absolute;
bottom:20%;
width:100%;
font-size:36px;
font-weight:bold;
opacity:0;
transition:2s;
color:#ff4d88;
}
</style>
</head>

<body>

<h2>Деница… натисни сърцето ❤️</h2>
<button id="heartBtn">❤️</button>

<div id="message">ДЕНИЦА, ОБИЧАМ ТЕ 💖</div>

<script>
const btn = document.getElementById("heartBtn");
const message = document.getElementById("message");

btn.addEventListener("click", function(){

btn.style.display="none";

/* Мечета */
const teddy1=document.createElement("div");
teddy1.innerHTML="🧸";
teddy1.className="teddy";
teddy1.style.left="20%";

const teddy2=document.createElement("div");
teddy2.innerHTML="🧸";
teddy2.className="teddy";
teddy2.style.right="20%";

document.body.appendChild(teddy1);
document.body.appendChild(teddy2);

/* Хвърляне на сърца */
let count=0;
let interval=setInterval(function(){
let heart=document.createElement("div");
heart.innerHTML="❤️";
heart.className="heart";
heart.style.left=Math.random()*100+"vw";
heart.style.top="40vh";
document.body.appendChild(heart);

setTimeout(()=>heart.remove(),3000);

count++;
if(count>25){
clearInterval(interval);
setTimeout(()=>{
message.style.opacity="1";
},2000);
}
},200);

});
</script>

</body>
</html>
